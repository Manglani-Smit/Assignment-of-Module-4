# Python Virtual Environments (har folder ke liye)
**/venv/
**/.venv/
**/env/

# Python Cache & Compiled Files
**/__pycache__/
**/*.pyc
**/*.pyo

# PyCharm & VS Code IDE files (Workspace warnings ko rokne ke liye)
.idea/
**/.idea/
.vscode/
**/.vscode/
*.xml
*.iml

# Har session ke Django SQLite Databases
**/*.sqlite3
**/*.sqlite3-journal
**/db.sqlite3

# User media uploads & logs
**/media/
**/*.log

# OS generated files
.DS_Store
Thumbs.db